APP_AUTH_MODE=local-bypass
# For server release, generate a gitignored password-mode env:
# npm run prepare:release-env -- --admin-email ops@example.com --base-url https://fund.example.com
# Local-bypass can keep placeholder values. APP_AUTH_MODE=password requires a non-default 32+ char secret.
SESSION_SECRET=change-me
# Set true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
ADMIN_EMAIL=admin@example.local
# APP_AUTH_MODE=password requires a non-default 12+ char password.
ADMIN_PASSWORD=change-me
HTTP_PORT=80
POSTGRES_DB=fundapp_road_fund
POSTGRES_USER=fundapp
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgres://fundapp:fundapp@localhost:5432/fundapp_road_fund

QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max

# 本机API原件存储目录，须与数据库一同备份；Compose使用独立持久卷。
# MATERIAL_STORAGE_ROOT=/absolute/private/material-storage

# Optional: explicitly enabled vision model on the same existing Qwen endpoint/key.
# No automatic model replacement; qwen3.7-max currently exposes text-only input.
# QWEN_VISION_MODEL=qwen3.7-plus
